<view class="invoiceContainer">
  <view class="card">
    <view class="cardTitle">开票说明</view>
    <view class="rule">1. 目前支持对已支付的租借订单开具电子发票。</view>
    <view class="rule">2. 请选择需要开票的订单，并联系客服提供开票信息。</view>
    <view class="rule">3. 发票将在核实后发送至你预留的邮箱。</view>
  </view>

  <view class="card">
    <view class="cardTitle">可开票订单</view>
    <view wx:if="{{a}}" class="orderList">
      <view wx:for="{{b}}" wx:for-item="order" wx:key="d" class="orderItem">
        <view class="orderLeft">
          <text class="orderNo">订单 {{order.a}}</text>
          <text class="orderTime">{{order.b}}</text>
        </view>
        <text class="orderAmount">￥{{order.c}}</text>
      </view>
    </view>
    <view wx:else class="emptyText">暂无可开票订单</view>
  </view>

  <button class="contactBtn" open-type="contact" hover-class="none">联系客服开具发票</button>
</view>

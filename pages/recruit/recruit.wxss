.recruitContainer {
  min-height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: var(--bg-page);
}
.recruitContainer .banner {
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  box-shadow: 0 8rpx 24rpx rgba(47, 174, 135, 0.24);
}
.recruitContainer .banner .bannerTitle {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
}
.recruitContainer .banner .bannerDesc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}
.recruitContainer .card {
  margin-top: 24rpx;
  padding: 32rpx;
  background-color: var(--bg-card);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
}
.recruitContainer .card .cardTitle {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}
.recruitContainer .card .item {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
}
.recruitContainer .card .item .dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  flex-shrink: 0;
}
.recruitContainer .card .item .itemBody {
  flex: 1;
}
.recruitContainer .card .item .itemBody .itemTitle {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
}
.recruitContainer .card .item .itemBody .itemDesc {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--text-2);
}
.recruitContainer .card .step {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
}
.recruitContainer .card .step .stepNo {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background-color: rgba(47, 174, 135, 0.12);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  flex-shrink: 0;
}
.recruitContainer .card .step .stepBody {
  flex: 1;
}
.recruitContainer .card .step .stepBody .stepTitle {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
}
.recruitContainer .card .step .stepBody .stepDesc {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--text-2);
}
.recruitContainer .contactBtn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  margin-top: 40rpx;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  box-shadow: 0 8rpx 24rpx rgba(47, 174, 135, 0.28);
}
.recruitContainer .contactBtn::after {
  border: none;
}
.recruitContainer .tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}

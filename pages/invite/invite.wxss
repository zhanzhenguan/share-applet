.inviteContainer {
  min-height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: var(--bg-page);
}
.inviteContainer .banner {
  padding: 56rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  box-shadow: 0 8rpx 24rpx rgba(47, 174, 135, 0.24);
}
.inviteContainer .banner .bannerTitle {
  font-size: 44rpx;
  font-weight: 600;
  color: #fff;
}
.inviteContainer .banner .bannerDesc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}
.inviteContainer .card {
  margin-top: 24rpx;
  padding: 32rpx;
  background-color: var(--bg-card);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
}
.inviteContainer .card .cardTitle {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}
.inviteContainer .card .step {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
}
.inviteContainer .card .step .stepNo {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background-color: rgba(47, 174, 135, 0.12);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  flex-shrink: 0;
}
.inviteContainer .card .step .stepBody {
  flex: 1;
}
.inviteContainer .card .step .stepBody .stepTitle {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
}
.inviteContainer .card .step .stepBody .stepDesc {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--text-2);
}
.inviteContainer .card .rule {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 42rpx;
  color: var(--text-2);
}
.inviteContainer .shareBtn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  margin-top: 40rpx;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  box-shadow: 0 8rpx 24rpx rgba(47, 174, 135, 0.28);
}
.inviteContainer .shareBtn::after {
  border: none;
}

      <image class="itemImg" src="/static/images/商店小卖部.png" mode=""></image><text class="itemText">附近门店</text>
    </view>
    <view class="bottomCenter" bindtap="{{c}}">
      <image class="centerImg" src="/static/images/扫码.png" mode=""></image> 扫码充电

.indexContainer {
  position: relative;
  height: 100%;
  overflow: hidden;
  background-color: #fff;
}
.indexContainer .map {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}
.indexContainer .indexBottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background-color: rgba(255, 255, 255, 0.98);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(17, 24, 39, 0.08);
}
.indexContainer .indexBottom .bottomItem {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: opacity 0.15s;
}
.indexContainer .indexBottom .bottomItem:active {
  opacity: 0.6;
}
.indexContainer .indexBottom .bottomItem .itemImg {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}
.indexContainer .indexBottom .bottomItem .itemText {
  font-size: 24rpx;
  color: var(--text-2);
}
.indexContainer .indexBottom .bottomCenter {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin: 0 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(47, 174, 135, 0.3);
}
.indexContainer .indexBottom .bottomCenter:active {
  opacity: 0.9;
}
.indexContainer .indexBottom .bottomCenter .centerImg {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
}
.indexContainer .maskContainer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: rgba(17, 24, 39, 0.45);
}
.indexContainer .maskContainer .content {
  padding: 32rpx 48rpx;
  background-color: #fff;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: var(--text-1);
  box-shadow: var(--shadow-float);
}
.indexContainer .maskContainer .mask {
  display: none;
}

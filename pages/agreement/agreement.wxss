.agreementContainer {
  min-height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: var(--bg-page);
}
.agreementContainer .header {
  padding: 24rpx 8rpx 32rpx;
}
.agreementContainer .header .title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-1);
}
.agreementContainer .header .update {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.agreementContainer .card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  background-color: var(--bg-card);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
}
.agreementContainer .card .cardTitle {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-color);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
}
.agreementContainer .card .section {
  margin-top: 28rpx;
}
.agreementContainer .card .section .sectionTitle {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}
.agreementContainer .card .section .paragraph {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 44rpx;
  color: var(--text-2);
}
.agreementContainer .footer {
  padding: 16rpx 0 calc(40rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}

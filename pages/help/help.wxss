.helpContainer {
  min-height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: var(--bg-page);
}
.helpContainer .header {
  padding: 24rpx 8rpx 32rpx;
}
.helpContainer .header .title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-1);
}
.helpContainer .header .subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-3);
}
.helpContainer .faqList {
  overflow: hidden;
  border-radius: 24rpx;
  background-color: var(--bg-card);
  box-shadow: var(--shadow-card);
}
.helpContainer .faqItem {
  padding: 28rpx;
  border-bottom: 1rpx solid var(--border-color);
}
.helpContainer .faqItem:last-child {
  border-bottom: none;
}
.helpContainer .faqItem .faqHead {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.helpContainer .faqItem .faqHead .faqQ {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
}
.helpContainer .faqItem .faqHead .faqIcon {
  margin-left: 24rpx;
  font-size: 32rpx;
  color: var(--text-3);
}
.helpContainer .faqItem .faqA {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 42rpx;
  color: var(--text-2);
}
.helpContainer .contactBtn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  margin-top: 40rpx;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  box-shadow: 0 8rpx 24rpx rgba(47, 174, 135, 0.28);
}
.helpContainer .contactBtn::after {
  border: none;
}

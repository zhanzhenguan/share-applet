page {
  background: #F5F6F7;
}

.loginPage {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
}

.hero {
  background: linear-gradient(160deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  padding: 96rpx 48rpx 168rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  box-shadow: inset 0 0 0 12rpx rgba(255, 255, 255, 0.04), 0 16rpx 36rpx rgba(17, 24, 39, 0.14);
}

.powerMark {
  position: relative;
  width: 70rpx;
  height: 70rpx;
  border: 8rpx solid #FFFFFF;
  border-top-color: transparent;
  border-radius: 50%;
  box-sizing: border-box;
}

.powerMark::before {
  content: "";
  position: absolute;
  left: 50%;
  top: -22rpx;
  width: 8rpx;
  height: 48rpx;
  margin-left: -4rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
}

.appName {
  margin-top: 28rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.slogan {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.panel {
  margin: -96rpx 40rpx 0;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 40rpx 48rpx;
  box-shadow: 0 12rpx 40rpx rgba(17, 24, 39, 0.1);
}

.features {
  display: flex;
  justify-content: space-between;
  margin-bottom: 48rpx;
}

.feature {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #646A73;
}

.featureDot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-primary);
  margin-bottom: 12rpx;
}

.errorText {
  font-size: 24rpx;
  color: #EF4444;
  text-align: center;
  margin-bottom: 20rpx;
}

.loginBtn {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  padding: 0;
}

.loginBtn::after {
  border: none;
}

.loginBtn--loading {
  opacity: 0.6;
  color: #FFFFFF;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
}

.agreement {
  display: flex;
  align-items: flex-start;
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #8F959E;
  line-height: 36rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #C9CDD4;
  margin-right: 12rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.checkbox--checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.checkboxIcon {
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 1;
}

.agreementText {
  flex: 1;
}

.link {
  color: var(--color-primary-dark);
}

.guestBtn {
  margin-top: 36rpx;
  text-align: center;
  font-size: 26rpx;
  color: #646A73;
  padding: 16rpx 0;
}

.footer {
  margin-top: auto;
  padding: 40rpx 0 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B0B4BB;
}
